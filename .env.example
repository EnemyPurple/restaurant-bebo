DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# preserve (local) | full (Render) | media-only | off
BUNDLED_MEDIA_MODE=preserve

# Database
POSTGRES_DB=bebo
POSTGRES_USER=bebo
POSTGRES_PASSWORD=bebo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (оставьте пустым без Docker)
REDIS_URL=

# Email (dev defaults to console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Бебо <noreply@bebo.local>

# reCAPTCHA (optional)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Security (prod)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
